# FestaBox ERP — Variáveis de ambiente (exemplo)
# Copie para .env e ajuste para seu ambiente.

# Banco de dados (PostgreSQL recomendado)
DATABASE_URL="postgresql://festabox:festabox@localhost:5432/festabox?schema=public"

# Para rodar rapidamente com SQLite (dev), troque o provider em prisma/schema.prisma:
#   provider = "sqlite"
#   url      = "file:./dev.db"
# e use DATABASE_URL="file:./dev.db"

# NextAuth (Auth.js v5)
AUTH_SECRET="please-replace-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3001"
NEXTAUTH_URL="http://localhost:3001"

# Impressora padrão
PRINTER_DEFAULT_PDV="generic-escpos-80mm"
PRINT_AUTOCUT=true

# Outras
NODE_ENV="development"